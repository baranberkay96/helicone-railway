          "required": false
        },
        "FLYWAY_PASSWORD": {
          "defaultValue": "${{Postgres.PGPASSWORD}}",
          "description": "Postgres password (reference).",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Postgres connection string for the admin bootstrap.",
          "required": false
        },
        "CLICKHOUSE_HOST": {
          "defaultValue": "http://${{clickhouse.RAILWAY_PRIVATE_DOMAIN}}:8123",
          "description": "ClickHouse HTTP endpoint.",
          "required": false
        },
        "CLICKHOUSE_USER": {
          "defaultValue": "default",
          "description": "ClickHouse user.",
          "required": false
        },
        "CLICKHOUSE_PASSWORD": {
          "defaultValue": "${{clickhouse.CLICKHOUSE_PASSWORD}}",
          "description": "ClickHouse password (reference).",
          "required": false
        },
        "CLICKHOUSE_HQL_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
