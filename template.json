      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/ping",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/clickhouse"
      },
      "variables": {
        "PORT": {
          "defaultValue": "8123",
          "description": "HTTP port; /ping is the healthcheck.",
